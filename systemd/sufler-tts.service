# sufler voice service: Chatterbox Multilingual TTS on 127.0.0.1:8791.
# Install: scripts/install_tts.sh (deps, weights, prompts; links this unit into
#          ~/.config/systemd/user and reloads; it does not enable it).
# Enable:  systemctl --user enable --now sufler-tts.service
[Unit]
Description=sufler voice service (Chatterbox TTS, loopback :8791)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/src/sufler/tts
ExecStart=%h/src/sufler/tts/.venv/bin/python -m sufler_tts
# Weights live in ~/.local/share/sufler/chatterbox/<revision> (install_tts.sh);
# the hub stays offline so nothing in chatterbox reaches the network at runtime.
Environment=HF_HUB_OFFLINE=1
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
# The model lives in a child process that exits after 10 min idle; stopping
# the unit takes that child down too.
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=default.target
